# UpdateAsset: codex-desktop-{version}-{pkgrel}-{arch}.pkg.zst
# UpdateSource: https://github.com/{repo}/releases/download/{tag}/{asset}
pkgname=codex-desktop
pkgver=26.924.51851
pkgrel=1
pkgdesc='ChatGPT desktop application for Manjaro KDE'
arch=('x86_64')
url='https://github.com/pygojrc/codex-desktop-linux/releases/tag/manjaro-kde-26.924.51851'
license=('custom:upstream')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'gtk3'
  'libcups'
  'libdrm'
  'libglvnd'
  'libnotify'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'libusb'
  'xdg-utils'
  'xz'
)

optdepends=(
  'fcitx5: Chinese input method support'
  'fcitx5-rime: Rime Wubi input support'
  'git: project source control integration'
  'kde-cli-tools: opening files/trash on KDE'
  'pulseaudio: audio integration'
)

provides=('chatgpt')
conflicts=('chatgpt')
options=(!debug !strip)

_release_file="${pkgname}-${pkgver}-${pkgrel}-${arch}.pkg.zst"
source=("https://github.com/pygojrc/codex-desktop-linux/releases/download/manjaro-kde-26.924.51851/codex-desktop-26.924.51851-1-x86_64.pkg.zst")
sha256sums=('d4cf9b1d1b6407d95d55789e8c2a38236c1f82728efe2ba3f1bce6cf6e3a0ae9')

package() {
  # 只解包上游已签名/校验的 Manjaro 包内容，排除 pacman 元数据文件。
  bsdtar -xpf "${srcdir}/${_release_file}" -C "${pkgdir}" \
    --exclude='.PKGINFO' \
    --exclude='.BUILDINFO' \
    --exclude='.MTREE'
}
